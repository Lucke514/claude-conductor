{
  "chain": ["codex", "antigravity", "claude"],
  "routing": {
    "review": { "provider": "codex", "keywords": ["review", "revisa", "revisar", "audit", "code review"] },
    "refactor": { "provider": "antigravity", "keywords": ["refactor", "refactoriza", "rename", "extract"] },
    "tests": { "provider": "codex", "keywords": ["test", "tests", "spec", "vitest", "jest"] },
    "docs": "antigravity"
  },
  "defaults": {
    "mode": "read",
    "timeoutMs": 600000,
    "maxFileBytes": 65536,
    "maxTotalBytes": 524288,
    "maxDiffBytes": 204800
  },
  "circuitBreaker": {
    "threshold": 3,
    "cooldownMs": 300000
  },
  "retry": {
    "maxRetries": 2,
    "baseDelayMs": 2000,
    "maxDelayMs": 30000,
    "factor": 2,
    "retryOn": ["RATE_LIMIT", "TIMEOUT"]
  },
  "isolation": {
    "readMode": "worktree",
    "includeUncommitted": true,
    "symlink": ["node_modules"]
  },
  "verify": {
    "commands": ["npm run lint", "npm test"],
    "timeoutMs": 300000
  },
  "statusline": {
    "mode": "compact"
  },
  "providers": {
    "codex": {
      "enabled": true,
      "binaryPath": "codex",
      "extraArgs": ["--ephemeral"],
      "usePty": false,
      "skipGitRepoCheck": true,
      "timeoutMs": 900000,
      "authCheckArgs": ["login", "status"],
      "errorPatterns": {
        "RATE_LIMIT": ["rate.?limit", "\\b429\\b", "too many requests", "at capacity", "high demand"]
      }
    },
    "antigravity": {
      "enabled": true,
      "binaryPath": "agy",
      "extraArgs": [],
      "usePty": true,
      "outputFormat": "text",
      "modelFlag": "--model",
      "readModeArgs": [],
      "writeModeArgs": ["--dangerously-skip-permissions"],
      "versionArgs": ["--version"],
      "authCheckArgs": [],
      "errorPatterns": {
        "AUTH": ["authentication required", "failed to retrieve token", "keyring is locked", "unauthenticated", "\\b401\\b"]
      }
    }
  }
}
